        <!-- Screens: shown only while the game is not playing, over a scrim that
             dims the board. Declared first so they draw on top (first sibling is
             topmost). Each overlay and the scrim take their opacity from a number
             in the Game view model that main.luau eases up and down, so they fade;
             the stats block is shared by the three end screens. Placeholder
             styling for the art pass to replace. Neither the text nor the scrim
             is opaque to hits, so clicks still reach the playfield beneath. -->
        <Node opacity="0" name="Ready Screen" id="0:763">
            <DataBindContext sourcePathIds="0:100-0:704" propertyKey="18" id="0:764"/>
            <Text x="480" y="340" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Ready Title" id="0:730">
