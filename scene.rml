        <!-- Health and boost, in the bottom wall band (y 920-960). Placeholder
             look: a groove and a bound fill per bar. The rectangle's width is
             what is bound, so each converter's output range must match the
             groove width (120 for HP and vision, 200 for boost). Each fill is declared before its groove: the
             first sibling is drawn on top. -->
        <Text x="48" y="940" originX="0" originY="0.5" sizingValue="autoWidth" name="HP Label" id="0:600">
            <TextStylePaint fontSize="16" fontAssetId="0:90" familyName="Inter" styleName="Regular" name="Style" id="0:601">
