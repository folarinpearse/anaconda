        <!-- Playfield: a fill-sized layout parent gives the script the artboard
             size; FocusData is a direct child of the ScriptedLayout so it gets keys. -->
        <LayoutComponent width="960" height="960" styleId="0:11" name="Playfield Root" id="0:10">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill"
                                  name="Playfield Root Style" id="0:11"/>
            <ScriptedLayout scriptAssetId="0:80" name="Anaconda Game" id="0:12">
                <FocusData id="0:145"/>
                <ScriptInputArtboard artboardId="0:200" name="person" id="0:529"/>
            </ScriptedLayout>
        </LayoutComponent>

        <Fill name="Background" id="0:146">
            <SolidColor colorValue="FF14171C" name="Color" id="0:147"/>
        </Fill>

        <!-- Focus: only the CLI player focuses the first FocusData on its own; the
             Editor and web/embed runtimes do not. Request it from the file:
             on load (entry state below) and on every pointer down. targetId
             names the node that owns the FocusData (the ScriptedLayout 0:12),
             not the FocusData itself. -->
        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="200" y="-120" id="0:148"/>
                <ExitState x="400" y="-120" id="0:149"/>
                <EntryState id="0:150">
                    <StateTransition stateToId="0:160" id="0:531"/>
                </EntryState>
                <AnimationState x="160" y="0" animationId="0:161" id="0:160">
                    <FocusActionTarget targetId="0:12" id="0:532"/>
                </AnimationState>
            </StateMachineLayer>
            <StateMachineListenerSingle listenerTypeValue="down" targetId="0:10" name="Focus On Press" id="0:162">
                <FocusActionTarget targetId="0:12" id="0:533"/>
            </StateMachineListenerSingle>
        </StateMachine>

        <LinearAnimation duration="1" name="Focus Hold" id="0:161"/>
    </Artboard>

    <FontAsset file="Inter.ttf" name="Inter" id="0:90"/>
    <!-- Modules register in document order: sim before whatever requires it. -->
    <ScriptAsset file="config.luau" isModule="true" name="config" id="0:84"/>
    <ScriptAsset file="level.luau" isModule="true" name="level" id="0:83"/>
    <ScriptAsset file="fog.luau" isModule="true" name="fog" id="0:85"/>
    <ScriptAsset file="sim.luau" isModule="true" name="sim" id="0:81"/>
    <ScriptAsset file="sim_test.luau" name="sim_test" id="0:82"/>
    <ScriptAsset file="main.luau" name="main" id="0:80"/>

    <DataConverterToString decimals="0" round="true" name="To Text" id="0:120"/>

    <!-- HP (0 to MAX_HP in config.luau) onto the 120px groove. -->
    <DataConverterRangeMapper minInput="0" maxInput="5" minOutput="0" maxOutput="120"
                              clampLower="true" clampUpper="true" name="HP To Width" id="0:640"/>
    <!-- vision (0 to 1) onto the 120px groove. -->
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="0" maxOutput="120"
                              clampLower="true" clampUpper="true" name="Vision To Width" id="0:642"/>
    <!-- boostCooldown is 1 just after a lunge and 0 when ready: the fill grows
         as the boost recharges, full = ready. -->
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="200" maxOutput="0"
                              clampLower="true" clampUpper="true" name="Recharge To Width" id="0:641"/>

    <!-- The dim scrim's opacity: the shown-screen fade (0 to 1) onto 0 to 0.72. -->
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="0" maxOutput="0.72"
                              clampLower="true" clampUpper="true" name="Dim To Opacity" id="0:900"/>

    <DataEnumCustom name="GameState" id="0:110">
        <DataEnumValue key="ready" value="CLICK OR PRESS SPACE TO START" id="0:111"/>
        <DataEnumValue key="playing" value="PLAYING" id="0:112"/>
        <DataEnumValue key="won" value="YOU WIN - SPACE" id="0:113"/>
        <DataEnumValue key="lost" value="GAME OVER - SPACE" id="0:114"/>
    </DataEnumCustom>

    <!-- Why the game ended. `cleared` is the win; `walls` and `escaped` are the
         two ways to lose. `none` while the game is on. -->
    <DataEnumCustom name="EndReason" id="0:720">
        <DataEnumValue key="none" value="NONE" id="0:721"/>
        <DataEnumValue key="cleared" value="CLEARED" id="0:722"/>
        <DataEnumValue key="walls" value="WALLS" id="0:723"/>
