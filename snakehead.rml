<Rive version="1" kind="fragment">
    <!-- SnakeHead: a 48x48 placeholder head that faces RIGHT (+x). The rig is
         anchored at the neck joint (12,24), so the game script positions the
         neck on the snake's head point and rotates the artboard around it.
         Its state machine plays one visibly different animation per value of
         the `state` enum on its own view model (idle, lunge, eat, hit); the
         `hunger` number (0-1, 1 = vision at the floor) widens the pupils and
         lights the eyes red. Node names are the contract with main.luau and
         the Rive Editor art pass: keep them when redrawing. -->
    <Artboard x="1200" y="0" defaultStateMachineId="0:1011" viewModelId="0:1029" viewModelInstanceId="0:1032"
              width="48" height="48" styleId="0:1001" name="SnakeHead" id="0:1000">
        <LayoutComponentStyle name="SnakeHead Style" id="0:1001"/>

